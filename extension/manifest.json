{
  "manifest_version": 3,
  "name": "ClassPilot Schoology Sync",
  "version": "0.3.4",
  "description": "ClassPilot's official Schoology sync extension. Imports classes and assignments and keeps them updated automatically while Schoology is open.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://*.schoology.com/*", "https://schoology.com/*", "https://class-pilot-sigma.vercel.app/*", "https://*.supabase.co/*"],
  "background": { "service_worker": "service_worker.js" },
  "action": { "default_title": "ClassPilot — Schoology Sync", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://*.schoology.com/*", "https://schoology.com/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://class-pilot-sigma.vercel.app/*"], "js": ["classpilot-content.js"], "run_at": "document_idle" }
  ]
}
